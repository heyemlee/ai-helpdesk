{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heyemlee/a2a-contract/schema/progress-event.schema.json",
  "title": "progress 事件信封（SSE 一条 data: 的完整内容）",
  "description": "契约 §4.1 / §4.3。校验对象是 `data: ` 后面那个完整的 JSON-RPC 2.0 响应对象，不是 result 里面那一层——信封本身也是契约面（§4.1「每个 SSE data: 承载一个完整的 JSON-RPC 2.0 响应，id 与请求一致」）。",

  "type": "object",
  "required": ["jsonrpc", "id", "result"],
  "additionalProperties": false,
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": {
      "type": ["string", "number"],
      "$comment": "§4.1：与请求的 id 一致。null 不合法——那是 JSON-RPC 通知的形态，本链路不用。"
    },
    "result": { "$ref": "#/$defs/statusUpdateWorking" }
  },

  "$defs": {
    "statusUpdateWorking": {
      "type": "object",
      "required": ["kind", "taskId", "contextId", "final", "status", "metadata"],
      "additionalProperties": true,
      "properties": {
        "kind": { "const": "status-update" },
        "taskId": { "type": "string", "minLength": 1 },
        "contextId": { "type": "string" },
        "final": {
          "const": false,
          "$comment": "§4.3：进度事件的 final 恒为 false。final:true 的是终态事件，不该用本 schema 校验。"
        },
        "status": {
          "type": "object",
          "required": ["state", "timestamp"],
          "additionalProperties": true,
          "properties": {
            "state": { "const": "working" },
            "timestamp": { "type": "string", "format": "date-time" },
            "message": { "$ref": "#/$defs/agentMessage" }
          }
        },
        "metadata": { "$ref": "#/$defs/progressMetadata" }
      }
    },

    "progressMetadata": {
      "type": "object",
      "description": "§4.3：metadata 放在**事件根**而不是 status.message.metadata 里——调用方读一跳就拿到。stage 与 trace_id 必填，其余可选且**调用方必须容忍缺失**。",
      "required": ["stage", "trace_id"],
      "additionalProperties": true,
      "properties": {
        "stage": { "$ref": "stage.schema.json" },
        "trace_id": { "type": "string", "minLength": 1 },
        "step": {
          "type": "integer",
          "minimum": 1,
          "$comment": "§4.5：从 1 开始。只在按步骤重复的 stage 上出现。"
        },
        "database": { "$ref": "database-id.schema.json" },
        "dialect": { "type": "string" },
        "with_memory": { "type": "boolean" },
        "short_path": { "type": "boolean" }
      },
      "allOf": [
        {
          "$comment": "§4.5：generation / execution / repair / validation 是按 step 重复的 stage，必须带 step。没有 step 的话调用方无法执行「repair 的 step 必须严格递增」那条判据。",
          "if": {
            "properties": { "stage": { "enum": ["generation", "execution", "repair", "validation"] } },
            "required": ["stage"]
          },
          "then": { "required": ["step"] }
        },
        {
          "$comment": "§4.5：进度事件只带**进入 stage 时已经知道**的字段。route / confidence / 命中表名要到 stage 结束才有值，所以永远不该出现在进度事件里——出现了就是服务端把事后信息塞进了事前事件。",
          "not": {
            "anyOf": [
              { "required": ["route"] },
              { "required": ["confidence"] },
              { "required": ["tables"] },
              { "required": ["changed"] }
            ]
          }
        }
      ]
    },

    "agentMessage": {
      "type": "object",
      "required": ["kind", "role", "parts"],
      "additionalProperties": true,
      "properties": {
        "kind": { "const": "message" },
        "role": { "const": "agent" },
        "messageId": { "type": "string" },
        "taskId": { "type": "string" },
        "contextId": { "type": "string" },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "text"],
            "properties": {
              "kind": { "const": "text" },
              "text": {
                "type": "string",
                "$comment": "§4.5：这是**兜底文案**，不保证稳定。调用方不得解析它——中文映射按 stage / database 自己做。§7.1 推论：终态之前的任何事件都不含答案内容，这里只能是阶段文案。"
              }
            }
          }
        }
      }
    }
  }
}
