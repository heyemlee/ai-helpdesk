server {
    listen 80;
    # 官方 entrypoint 的 10-listen-on-ipv6-by-default.sh 在渲染模板之前就跑完了，
    # 它给存量 default.conf 加的 IPv6 监听会被这个模板覆盖掉。
    # 容器内的 localhost 先解析成 ::1，缺了这行健康检查会一直 connection refused。
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 10M;

    # 用容器内置 DNS 在「请求时」解析后端地址，而不是启动时解析一次。
    # nginx 默认对 proxy_pass 里的字面主机名只在启动时解析：
    #   - 后端还没就绪时，前端容器会直接 [emerg] host not found 启动失败；
    #   - 后端重启换了 IP 之后，前端会一直打到旧地址。
    # 把地址放进变量并配 resolver，就变成每次请求按 TTL 重新解析，
    # 后端不可用时返回 502，而不是让整个前端起不来。
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # SPA 路由：任何未命中静态文件的路径都回落到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # /api/docs 是 FastAPI 的 Swagger 页，里面写死 `url: '/openapi.json'`（无前缀）。
    # 不单独转发的话它会命中上面的 SPA 兜底拿到 index.html，文档页永远加载不出规格。
    location = /openapi.json {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass http://$api_upstream/openapi.json;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        # proxy_pass 用变量时 nginx 不会自动剥掉 location 前缀，必须手动 rewrite
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 评测和多 Agent 并行链路可能跑得比较久，超时放宽到 120s
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # ── SQL Agent（数据页面）──────────────────────────────────────────────────
    # 浏览器只认 /sql-api/：去掉前缀转给 SQL Agent（compose 里是 sql-agent:8000，只在 sql-net 上），
    # **在这里替浏览器加上控制台那把管理员 Key**。Key 只在这个容器里：从只读挂进来的
    # /run/secrets/console/sql_agent_key 读出来（docker/entrypoint/16-sql-api-key.envsh），
    # 浏览器拿不到，JS 包里也没有；浏览器自己带的 X-API-Key 被下面这行覆盖掉。
    #
    # 代价是"连得到控制台就是管理员"：控制台只绑本机，在容器之间只挂 sql-net（合仓设计 §3.3，
    # backend/tests/test_deployment_compose.py 断言）。没配 Key 时这一行是空值，nginx 不发这个头，
    # SQL Agent 回 401，页面说"控制台的 Key 要管理员核对"。
    location /sql-api/ {
        set $sql_upstream "${API_SQL_UPSTREAM}";
        rewrite ^/sql-api/(.*)$ /$1 break;
        proxy_pass http://$sql_upstream;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key "${API_SQL_KEY}";

        # 问数走 A2A 的 message/stream（SSE）：不缓冲，进度一来就往浏览器送。
        # 读超时要盖过流的硬上限（契约里是 90 秒）和一次 /query 的最长耗时
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}
