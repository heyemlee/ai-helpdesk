AI_SQL_APP_ENV=production
AI_SQL_DEPLOYMENT_SCOPE=internal_single_tenant
AI_SQL_AUTH_MODE=api_key
AI_SQL_API_KEYS_FILE=/run/secrets/sql_agent_keys.json
AI_SQL_UNKNOWN_ROLE_POLICY=deny
AI_SQL_SEMANTIC_DIR=/app/semantic
AI_SQL_AUDIT_DB_PATH=/app/state/audit.db
AI_SQL_RUNS_DB_PATH=/app/state/runs.db
AI_SQL_MEMORY_DB_PATH=/app/state/memory.db
AI_SQL_MODEL_SETTINGS_PATH=/app/state/model_settings.json
AI_SQL_LOG_FORMAT=json
# 模型是 mock-llm（scripts/mock_llm.py）：生产就绪检查只看有没有凭据，查询会失败，员工实例退回知识库和 SOP。
# 接真模型时换掉这三项和 sql-agent-secrets.env 里的 Key
AI_SQL_MODEL_PROVIDER=openai
AI_SQL_OPENAI_BASE_URL=http://mock-llm:9000/v1
AI_SQL_CHAT_MODEL=mock-1
AI_SQL_CODER_MODEL=mock-1
