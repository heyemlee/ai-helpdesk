# 和 docker-compose.yml 的 ai-helpdesk-customer 一样：不接 ai-sql-agent、不用跨会话记忆、
# 不开工具循环、事件日志的读接口关掉。派发队列按实例分开，员工的 worker 领不到这里的 run
AI_HELPDESK_INSTANCE=customer
OTEL_SERVICE_NAME=ai-helpdesk-customer
SQL_AGENT_URL=
ENABLE_CROSS_SESSION_MEMORY=false
AI_HELPDESK_TOOL_LOOP=off
AI_HELPDESK_EVENT_LOG_BODY_DAYS=14
AI_HELPDESK_EVENT_LOG_READ=off
