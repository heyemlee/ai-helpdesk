APP_ENV=development
LOG_FORMAT=json
LOG_LEVEL=INFO
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://mock-llm:9000/v1
OPENAI_MODEL=mock-1
REDIS_URL=redis://redis:6379/0
POSTGRES_DSN=postgresql://aihd:aihd@postgres:5432/aihd
AI_HELPDESK_EVENT_LOG=full
AI_HELPDESK_RUN_MODE=queued
AI_HELPDESK_WORKER_CONCURRENCY=4
AI_HELPDESK_RUN_LEASE_S=15
AI_HELPDESK_RUN_REDISPATCH_S=20
AI_HELPDESK_RUN_QUEUE_MAX=200
AI_HELPDESK_RUN_DRAIN_S=90
AI_HELPDESK_DEGRADE_BACKLOG=20,40,80,160
AI_HELPDESK_LLM_RPM=0
AI_HELPDESK_LLM_TPM=0
AI_HELPDESK_FRONTEND_DIST=/nonexistent
