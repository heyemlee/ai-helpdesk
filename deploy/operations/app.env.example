APP_ENV=production
AI_HELPDESK_INSTANCE=staff
AI_HELPDESK_STAFF_AUTH=local
AI_HELPDESK_DEPLOYMENT_SCOPE=internal_single_tenant
AI_HELPDESK_API_KEY=
AI_HELPDESK_AUTH_SECRET=
AI_HELPDESK_PROTECT_CHAT=true
AI_HELPDESK_TOKEN_ISSUER_CIDRS=127.0.0.1/32
SQL_AGENT_API_KEY=
SQL_AGENT_USER_ID=ai-helpdesk
SQL_AGENT_IMPERSONATE=false
AI_HELPDESK_ATTACHMENT_BUCKET=
AI_HELPDESK_ATTACHMENT_REGION=us-east-1
# Leave the endpoint empty for the standard cloud endpoint.
AI_HELPDESK_ATTACHMENT_ENDPOINT=
# Provision a least-privilege workload identity or runtime credentials externally.
LLM_PROVIDER=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# No notification destination is activated by this template.
TICKET_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
