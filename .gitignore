# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.venv.*/
venv/
.pytest_cache/
.ruff_cache/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo
*.log

# ── 密钥与本地配置 ────────────────────────────────────────────────────────────
# .env 有真实 API Key，绝不入库；.env.example 是模板，要入库
.env
.env.local
.env.bak*
.env.*.bak

# docker-deploy.sh backup 的产物：Redis dump、Chroma 向量库、config 副本。
# 其中含真实对话数据，且每次备份约 2MB。
backups/
*.pem

# ── 运行时数据 ────────────────────────────────────────────────────────────────
# 向量库和日志是本地状态，不进版本库
backend/data/chroma/
backend/logs/

# ── 私有资料 ─────────────────────────────────────────────────────────────────
# 本地草稿与工作笔记，不进版本库
doc/
private/

# ── IDE / 系统 ───────────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
