# ── Docker Compose 变量替换专用 ───────────────────────────────────────────────
#
# 这个文件只服务于 docker-compose.yml 里的 ${VAR} 替换。
#
# Compose 做变量替换时，只读「compose 文件所在目录」的 .env，也就是仓库根这一份。
# backend/.env 是另一回事：它通过 env_file 注入到应用容器内部，是运行时配置。
# 两者用途不同，不要互相搬运——在 backend/.env 里设置下面这些变量是不生效的。
#
# 用法：
#   cp .env.example .env
#
# 改完必须重建容器才生效，因为 Redis 的密码写在启动命令里，不是热加载的：
#   docker compose up -d --force-recreate redis ai-helpdesk

# Redis 密码。docker-compose.yml 有三处引用：
#   1. redis 服务的 --requirepass
#   2. redis 健康检查的 redis-cli -a
#   3. 应用容器的 REDIS_URL
# 不设置时 compose 回退到内置默认值 aihelpdesk123。
# 注意：改这里的同时，backend/.env 里的 REDIS_PASSWORD / REDIS_URL 也要跟着改，
# 否则不走 Docker 的本地开发（./dev.sh）会连不上。
REDIS_PASSWORD=aihelpdesk123

# ai-helpdesk API 在宿主机上的端口（容器内始终是 8000）。
# 默认 8080：8000 留给同机的 ai-sql-agent，两个项目可以同时起。
AI_HELPDESK_PORT=8080
