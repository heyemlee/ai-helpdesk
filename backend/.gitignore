# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# 环境变量（含敏感信息）
.env

# 数据目录：运行时产物不入库（ChromaDB 索引等）
data/*
logs/

# 但演示知识库和评测基线必须入库：
# baseline.json 是回归检测的对比基准，不进版本控制就没法判断
# 某次发布相对"上一个被认可的版本"退化了多少。
!data/demo_docs/
!data/eval/
data/eval/*
!data/eval/baseline.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# ChromaDB 本地数据
*.sqlite3

# 备份文件
*~
*.bak
docker-compose(1).yml
