# ai-helpdesk 环境变量模板 —— 复制为 .env 后填值
#
# 注释掉的行 = 可选，留空即用代码默认值（括号里标出默认值）。
# 只有 ANTHROPIC_API_KEY 是非填不可的，其余全都有可用默认。
# 各项背后的取舍见 backend/README.md 和 backend/wiki/。

# ════ LLM 供应商 ════════════════════════════════════════════════════════════
# 切换供应商只改 LLM_PROVIDER 这一行，调用点一行不用动
# （两条路的差异在 core/openai_compat.py 里抹平）。两组配置可以同时留着。
LLM_PROVIDER=anthropic                       # anthropic | openai

ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.kabi.pro    # 第三方网关；留空走官方端点
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# LLM_PROVIDER=openai 时改读这一组
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.kabi.pro/v1    # 注意这组路径带 /v1
# OPENAI_MODEL=gpt-4o

LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# ⚠️ 推理模型会先输出思考块再输出正文。预算太小会在思考阶段就耗尽，
#    正文块根本不存在 —— 表现为结构化调用静默降级、Agent 返回空回复。别调小。
AI_HELPDESK_STRUCTURED_MAX_TOKENS=2048       # 意图识别 / Judge / 查询改写 / 重排
AI_HELPDESK_ANSWER_MAX_TOKENS=4096           # Agent 回复（system prompt 含整份 SKILL.md）

# ════ 存储 ══════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0

# 配置 POSTGRES_DSN 则工单/审计/知识库向量/记忆/画像全部落 Postgres，
# 向量检索走 pgvector；留空则整体退化为 SQLite 单文件，零外部依赖。
# POSTGRES_DSN=postgresql://aihelpdesk:aihelpdesk123@localhost:5432/aihelpdesk

# 以下三项仅在 SQLite 兜底模式下生效
VECTOR_STORE_DB_PATH=./data/vector_store.db
TICKET_DB_PATH=./data/tickets.db
CONVERSATION_LOG_DB_PATH=./data/conversations.db

# ════ 意图识别与检索 ════════════════════════════════════════════════════════
ENABLE_INTENT_FAST_PATH=true                 # 锚点命中直接定意图，跳过 Embedding 和 LLM

# Embedding（三路融合之一）。填了走远端真向量，留空退化为本地字符 n-gram 向量，
# 这一路无论如何都独立参与投票。
# ⚠️ 换嵌入后端会让已有向量全部失效，必须同步改 EMBEDDING_DIM 并重建向量表。
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-key
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=256                          # 远端 1536 / 本地 n-gram 256（默认 256）

# Cross-encoder 重排。留空则退回 LLM listwise 重排（多一次 LLM 往返）。
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_MODEL=rerank-multilingual-v3.0
# RERANK_TIMEOUT_S=10

# RAG_EVIDENCE_MIN_SCORE=0.5                 # 低于此分判定证据不足，触发一轮自纠错补检

# ════ Agent 与答案策略 ══════════════════════════════════════════════════════
AI_HELPDESK_AGENT_REPLICAS=2                 # >1 时 Monitor 的降权反馈才会真正改变路由
# AI_HELPDESK_AGENT_REPLICA_MODELS=          # 逗号分隔按实例序号给不同模型，如强模型+便宜模型

ENABLE_ANSWER_POLICY=true                    # 拦截无出处的价格/时效承诺。生产不要关
AI_HELPDESK_SKILLS_DIR=./skills              # 支持 POST /skills/reload 热加载
AI_HELPDESK_SKILLS_MAX_PROMPT_CHARS=5000

# ════ 安全（公网部署必配）═══════════════════════════════════════════════════
CORS_ALLOW_ORIGINS=*                         # 默认 * 只适合本地联调
AI_HELPDESK_PROTECT_CHAT=false               # /chat 是否也要求 X-API-Key

# 写操作端点（/skills/reload、/knowledge/*、/eval/*）的 X-API-Key。留空 = 鉴权关闭
# AI_HELPDESK_API_KEY=change_this_in_production
# 配置后 /chat 从 X-User-Token 推导 user_id，不再信任请求体。令牌由 POST /auth/token 签发
# AI_HELPDESK_AUTH_SECRET=change-me-32-bytes-random
# 每用户每分钟上限，0 = 不限流。计数存 Redis，多实例共享
# AI_HELPDESK_RATE_LIMIT_PER_MINUTE=20

# ════ 运维与可观测 ══════════════════════════════════════════════════════════
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=text                              # json = 单行结构化日志（ELK/Datadog），均带 request_id
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
SHUTDOWN_DRAIN_TIMEOUT_S=10                  # 优雅停机等待后台任务收尾的上限秒数

EVAL_BASELINE_PATH=./data/eval/baseline.json
# AI_HELPDESK_RELEASE=v2.0.0                 # 写进评测报告，用于定位哪次发布引入退化

# 配置后启用 FastAPI/httpx/redis/asyncpg 自动埋点 + 业务 span，经 Collector 进 Tempo。
# 留空 = 追踪关闭，零开销
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ai-helpdesk

# ALERT_WEBHOOK_URL=                         # 异常告警
# TICKET_WEBHOOK_URL=                        # 转人工工单创建通知（Slack / 企业微信 / 值班系统）
# AI_HELPDESK_FRONTEND_DIST=                 # 由后端托管前端静态文件时指向 dist 目录

# ════ 仅 docker compose 读取（Python 不读）══════════════════════════════════
REDIS_PASSWORD=aihelpdesk123
POSTGRES_USER=aihelpdesk
POSTGRES_PASSWORD=aihelpdesk123
POSTGRES_DB=aihelpdesk
GRAFANA_USER=admin
GRAFANA_PASSWORD=aihelpdesk123
