# ai-helpdesk 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=ai-helpdesk
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── LLM 供应商 ────────────────────────────────────────────────────────────────
# 用哪套协议调模型：
#   anthropic（默认）→ 读下面 ANTHROPIC_* 这组，走 Anthropic messages 协议
#   openai            → 读下面 OPENAI_* 这组，走 OpenAI 兼容的 /chat/completions
# 业务代码只写了一套 Anthropic 形状的调用，OpenAI 那条路在 core/openai_compat.py
# 里翻译（system/max_tokens/stop_reason/usage/流式一并对齐），所以切换供应商
# 就是改这一行，调用点一行不用动。两组配置可以同时留着，随时切回来。
LLM_PROVIDER=anthropic

# ── Anthropic 协议 ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# 可选：改成兼容 Anthropic 协议的第三方网关，留空走官方端点
# ANTHROPIC_BASE_URL=https://api.kabi.pro
# 可选：覆盖模型名（默认 claude-sonnet-4-5-20250929）。走网关时以网关支持的清单为准
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ── OpenAI 兼容协议（LLM_PROVIDER=openai 时生效）───────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
# 可选：第三方网关地址，注意这一组的路径通常带 /v1，留空走 OpenAI 官方端点
# OPENAI_BASE_URL=https://api.kabi.pro/v1
# 可选：覆盖模型名（默认 gpt-4o）
# OPENAI_MODEL=gpt-4o

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=aihelpdesk123

# ── Postgres（存储收敛：工单/审计/KB 向量/记忆/画像）──────────────────────────
# 配置后全部持久化数据进 Postgres，向量检索走 pgvector；
# 留空退化为 SQLite 单文件（demo/联调，零外部依赖）
# POSTGRES_DSN=postgresql://aihelpdesk:aihelpdesk123@localhost:5432/aihelpdesk
# 向量维度：远端 Embedding 默认 1536，本地 n-gram 256。换嵌入后端必须重建向量表
# EMBEDDING_DIM=256
# SQLite 兜底模式下向量库文件路径
VECTOR_STORE_DB_PATH=./data/vector_store.db

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 意图识别 ──────────────────────────────────────────────────────────────────
# 零延迟规则通道：高精度锚点短语命中时直接返回意图，跳过 Embedding 和 LLM
ENABLE_INTENT_FAST_PATH=true

# Embedding 这一路（三路融合之一）。配置了 OpenAI 兼容端点就用远端真向量，
# 留空则退化为本地字符 n-gram 向量，Embedding 依然独立参与投票。
# 用第三方网关时，填 OPENAI_BASE_URL / OPENAI_API_KEY 同样的值即可。
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-key
# EMBEDDING_MODEL=text-embedding-3-small

# ── LLM token 预算 ────────────────────────────────────────────────────────────
# 推理模型（claude thinking、OpenAI reasoning 系列等）会先输出思考块再输出正文。
# 预算太小会在思考阶段就耗尽，正文块根本不存在 —— 表现为结构化调用静默降级、
# Agent 返回空回复。用非推理模型时可以调小省钱。
AI_HELPDESK_STRUCTURED_MAX_TOKENS=2048   # 意图识别 / LLM Judge / 查询改写 / 重排
AI_HELPDESK_ANSWER_MAX_TOKENS=4096       # Agent 生成回复（system prompt 里有整份 SKILL.md）

# ── 答案策略 ──────────────────────────────────────────────────────────────────
# 出站校验：拦截无依据的价格承诺和时效承诺。生产环境不要关。
ENABLE_ANSWER_POLICY=true

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json
# 被评测的版本号，写进评测报告，用于定位是哪次发布引入了退化
# AI_HELPDESK_RELEASE=v2.0.0

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
AI_HELPDESK_SKILLS_DIR=./skills
AI_HELPDESK_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production
# CORS 白名单，逗号分隔。默认 * 只适合本地联调，部署时务必收敛。
CORS_ALLOW_ORIGINS=*

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true

# ── 鉴权 ──────────────────────────────────────────────────────────────────────
# 设置后，/skills/reload、/knowledge/add、/knowledge/upload、/eval/run、
# /eval/promote 需要请求头 X-API-Key。留空则鉴权关闭（仅适合本地）。
# AI_HELPDESK_API_KEY=change_this_in_production
# /chat 是否也要求 X-API-Key。demo 场景一般留 false，公网暴露建议 true。
AI_HELPDESK_PROTECT_CHAT=false

# ── Agent 实例数 ──────────────────────────────────────────────────────────────
# 每种 Agent 起几个实例。>1 时 Monitor 的在线表现反馈才会真正改变路由选择。
AI_HELPDESK_AGENT_REPLICAS=2
# 可选：给各实例指定不同模型（逗号分隔，按实例序号对应），留空则都用当前供应商的主模型。
# 模型名要属于当前 LLM_PROVIDER 那一套，例如 0 号用强模型、1 号用便宜模型
# AI_HELPDESK_AGENT_REPLICA_MODELS=claude-sonnet-4-5-20250929,claude-haiku-4-5-20251001

# ── 安全与限流（企业部署必配）─────────────────────────────────────────────────
# 用户令牌签名密钥。配置后 /chat 从 X-User-Token 推导 user_id，不再信任请求体；
# 令牌通过 POST /auth/token（需 X-API-Key）签发。留空 = demo 模式。
# AI_HELPDESK_AUTH_SECRET=change-me-32-bytes-random

# 每用户每分钟请求上限。0 = 不限流（demo 默认）。计数存 Redis，多实例共享。
# AI_HELPDESK_RATE_LIMIT_PER_MINUTE=20

# ── LLM 可靠性 ────────────────────────────────────────────────────────────────
# 所有 LLM 客户端统一的超时（秒）与 SDK 重试次数
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# ── 工单与审计 ────────────────────────────────────────────────────────────────
# 转人工工单 SQLite 路径；换 Postgres 时替换 tickets/ticket_store.py 即可
TICKET_DB_PATH=./data/tickets.db
# 对话审计日志（原文 append-only 留档，坐席经 GET /conversations/{conv_id} 回查）
CONVERSATION_LOG_DB_PATH=./data/conversations.db
# 工单创建时的 webhook 通知（Slack / 企业微信 / 值班系统）
# TICKET_WEBHOOK_URL=https://hooks.example.com/tickets

# ── 可观测性 ──────────────────────────────────────────────────────────────────
# json = 单行结构化日志（ELK/Datadog）；text = 本地可读格式。均带 request_id
LOG_FORMAT=text
# 优雅停机时等待后台任务（画像更新等）收尾的上限秒数
SHUTDOWN_DRAIN_TIMEOUT_S=10

# ── OpenTelemetry 追踪 ────────────────────────────────────────────────────────
# 配置后启用 FastAPI/httpx/redis/asyncpg 自动埋点 + 业务 span（intent/rag/agent/memory），
# trace 经 OTel Collector 进 Grafana Tempo。留空 = 追踪关闭，零开销
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Grafana ───────────────────────────────────────────────────────────────────
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=aihelpdesk123
