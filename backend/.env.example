# ai-helpdesk environment template -- copy to .env and fill in.
#
# Commented lines are optional; leaving one out falls back to the code default.
# ANTHROPIC_API_KEY is the only value you must supply.
# Rationale for each knob lives in backend/README.md and backend/wiki/.
#
# This file configures the Python app only. Docker Compose reads the repo-root
# .env for ${VAR} substitution -- setting REDIS_PASSWORD or POSTGRES_USER here
# has no effect on the containers.

# ==== LLM provider ==========================================================
# Switching providers is this one line; no call site changes.
# core/openai_compat.py flattens the difference. Keep both blocks if you like.
LLM_PROVIDER=anthropic                       # anthropic | openai

ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://your-gateway.example.com   # third-party gateway; empty = official endpoint
# ANTHROPIC_MODEL=claude-sonnet-5

# Read instead when LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://your-gateway.example.com/v1   # note the /v1 on this one
# OPENAI_MODEL=gpt-5.6-luna

LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Thinking depth for the structured calls -- intent, query rewrite, rerank, judge.
# These are discriminative tasks, not open-ended reasoning, so `low` is both cheaper
# and safer: it is long reasoning that exhausts the token budget before any answer
# block is produced. Raise it only if judge scores look unreliable.
# AI_HELPDESK_STRUCTURED_EFFORT=low

# Sampling knobs are gone on purpose. anthropic 1.x removed temperature/top_p/top_k
# from the messages signature -- passing one is a TypeError, not a 400, so the old
# probe-and-degrade workaround could not catch it. Determinism now comes from
# structured outputs, where the schema is enforced server-side.

# WARNING: reasoning models emit a thinking block before the answer. Too small a
# budget is spent during thinking and no answer block is ever produced -- which
# looks like silently degraded structured calls and empty agent replies. Do not lower.
AI_HELPDESK_STRUCTURED_MAX_TOKENS=2048       # intent / judge / query rewrite / rerank
AI_HELPDESK_ANSWER_MAX_TOKENS=4096           # agent reply (system prompt carries the whole SKILL.md)

# ==== Storage ===============================================================
REDIS_URL=redis://localhost:6379/0

# Set POSTGRES_DSN and tickets, audit, knowledge vectors, memory and profiles all
# land in Postgres, with vector search on pgvector. Leave it empty and everything
# degrades to a single SQLite file with no external dependencies.
# Under Docker Compose you do not set this by hand: the app container gets a DSN
# built from the root .env. Set it here only when running uvicorn directly.
# Use port 5433, not 5432: compose maps the container's 5432 to host 5433 because
# 5432 belongs to another project on this machine. Writing 5432 silently connects
# you to that other database.
# Use 127.0.0.1, not localhost: localhost may resolve to ::1, which something else
# may be holding.
# POSTGRES_DSN=postgresql://aihelpdesk:aihelpdesk123@127.0.0.1:5433/aihelpdesk

# The next three apply only in the SQLite fallback mode
VECTOR_STORE_DB_PATH=./data/vector_store.db
TICKET_DB_PATH=./data/tickets.db
CONVERSATION_LOG_DB_PATH=./data/conversations.db

# ==== Intent recognition and retrieval ======================================
ENABLE_INTENT_FAST_PATH=true                 # anchor hit settles intent, skipping embedding and the LLM

# Embedding, one of the three fused signals. Filled in, it calls a real remote
# vector backend; left empty, it degrades to a local character n-gram vector.
# Either way this signal votes.
# WARNING: changing the embedding backend invalidates every stored vector. You
# must change EMBEDDING_DIM to match and rebuild the vector tables.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-key
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=256                          # remote 1536 / local n-gram 256 (default 256)

# Cross-encoder rerank. Empty falls back to LLM listwise rerank, costing one more round trip.
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_MODEL=rerank-multilingual-v3.0
# RERANK_TIMEOUT_S=10

# RAG_EVIDENCE_MIN_SCORE=0.5                 # below this, evidence counts as thin and one self-correcting retrieval round fires

# ==== Agent and answer policy ===============================================
AI_HELPDESK_AGENT_REPLICAS=2                 # above 1, the monitor's demotion feedback actually changes routing
# AI_HELPDESK_AGENT_REPLICA_MODELS=          # comma separated, per replica index, e.g. a strong model plus a cheap one

ENABLE_ANSWER_POLICY=true                    # blocks unsourced price and turnaround promises. Keep this on in production
AI_HELPDESK_SKILLS_DIR=./skills              # supports hot reload via POST /skills/reload
AI_HELPDESK_SKILLS_MAX_PROMPT_CHARS=5000

# ==== Business data delegation (ai-sql-agent) ===============================
# Order status, delivery dates, stock and payment questions are answered from the
# ERP/MES/PM/WMS databases, not from the knowledge base. Those live behind
# ai-sql-agent, a separate service. Leave SQL_AGENT_URL empty and delegation is
# off entirely -- order questions then fall back to the knowledge base alone.
# SQL_AGENT_URL=http://localhost:8000
# SQL_AGENT_API_KEY=                         # X-API-Key for ai-sql-agent; empty when its auth is disabled (its local default)
# SQL_AGENT_TIMEOUT_S=45                     # 45, not the contract's 25: that 25 was set for A2A `message/send`,
#                                            # which is the rollback path. This is the main path. Measured on 12 real
#                                            # phrasings, the downstream ran to a 40.5s max and 3 of 13 queries blew
#                                            # past 25s -- and blew past it invisibly, since the downstream still
#                                            # answered 200 while the caller had already given up. Still well under
#                                            # the 90s ceiling the contract sets for streaming
# SQL_AGENT_INTENTS=                         # comma separated override; default covers order, order_status,
#                                            # delivery, order_change, missing_part, payment_issue.
#                                            # quote_pricing is deliberately excluded -- a quote is an external
#                                            # commitment and must not come from an ad-hoc query
# SQL_AGENT_USER_ID=ai-helpdesk              # service identity sent downstream. IMPORTANT: data visibility is
#                                            # decided by this key's role policy on ai-sql-agent, not by the
#                                            # customer asking. Scope that policy to the least-trusted visitor.
#                                            # This is a SINGLE-TENANT deployment: business data is NOT isolated
#                                            # per customer. Do not put one instance in front of several
#                                            # customers' data and call it isolation -- see backend/README.md
#                                            # "产品边界：单租户".
# SQL_AGENT_MAX_CONTEXT_CHARS=2000           # ai-sql-agent embeds the result rows as JSON in its answer; long
#                                            # result sets are truncated to this before entering the prompt
# SQL_AGENT_IMPERSONATE=false                # true forwards the real customer id instead. Requires
#                                            # can_impersonate on the downstream key, otherwise every call 403s.
#                                            # NOTE: this is identity forwarding, NOT permission isolation.
#                                            # Downstream impersonation swaps the user_id but keeps the service
#                                            # key's roles and policies; it does not re-resolve permissions for
#                                            # the end user. Verified: two customer identities, same visible data

# SQL_AGENT_CURRENCY=                        # the downstream returns amounts without a currency, so a Chinese
#                                            # answer defaults to writing 元 -- which is how a US plant's figures
#                                            # once went out to a builder in the wrong currency. This is a
#                                            # DEPLOYMENT-WIDE constant, not a property of the data: a deployment
#                                            # with several currencies will always be wrong somewhere, silently.
#                                            # The answer therefore names where the currency came from. Once
#                                            # ai-sql-agent ships the per-payload `currency` field (contract
#                                            # §4.6.5) that value wins and this one stops being mentioned

# ==== Security (required for public deployment) =============================
# With APP_ENV=production the process REFUSES TO START unless all three of
# AI_HELPDESK_API_KEY, AI_HELPDESK_AUTH_SECRET and AI_HELPDESK_PROTECT_CHAT are set.
# A missing one used to mean "this endpoint needs no auth" -- a deployment mistake
# that had no runtime symptom. Set APP_ENV=development for local work.
CORS_ALLOW_ORIGINS=*                         # the * default suits local development only
AI_HELPDESK_PROTECT_CHAT=false               # whether /chat also demands X-API-Key. Must be true in production

# X-API-Key for write endpoints (/skills/reload, /knowledge/*, /eval/*). Empty disables auth
# -- except on POST /auth/token, which never fails open: no key means 503, whatever APP_ENV says.
# That endpoint mints identities from a caller-supplied user_id, so "unconfigured" must never
# mean "open". Expose it to your gateway only, never to the public internet.
# AI_HELPDESK_API_KEY=change_this_in_production
# Once set, /chat derives user_id from X-User-Token and stops trusting the request body.
# Tokens are issued by POST /auth/token
# AI_HELPDESK_AUTH_SECRET=change-me-32-bytes-random
# Per-user ceiling per minute, 0 disables it. Counters live in Redis and are shared across instances
# AI_HELPDESK_RATE_LIMIT_PER_MINUTE=20

# ==== Operations and observability ==========================================
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8080                                # 8080, not 8000: another project on this machine owns 8000
LOG_LEVEL=INFO
LOG_FORMAT=text                              # json = single-line structured logs (ELK/Datadog), both carry request_id
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
SHUTDOWN_DRAIN_TIMEOUT_S=10                  # seconds a graceful shutdown waits for background tasks

EVAL_BASELINE_PATH=./data/eval/baseline.json
EVAL_CONCURRENCY=4                           # eval cases in flight at once. An eval run is almost entirely LLM wait,
                                             # so raising this speeds it up nearly linearly. The default 4 leaves
                                             # rate-limit headroom for real users
# AI_HELPDESK_RELEASE=v2.0.0                 # recorded in eval reports, to pin which release introduced a regression

# Set to enable auto-instrumentation for FastAPI/httpx/redis/asyncpg plus business
# spans, exported through the collector into Tempo. Empty = tracing off, zero overhead
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ai-helpdesk

# ALERT_WEBHOOK_URL=                         # anomaly alerts
# TICKET_WEBHOOK_URL=                        # human-handoff ticket notifications (Slack / WeCom / on-call)
# AI_HELPDESK_FRONTEND_DIST=                 # point at the dist directory when the backend serves the frontend
