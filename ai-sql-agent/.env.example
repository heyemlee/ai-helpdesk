# AI SQL Agent — local configuration template
#
# Usage: cp .env.example .env, then fill in real values.
# .env is gitignored and never gets committed.
#
# The main path (retrieval -> planning -> generation) only needs a Chat
# endpoint: keyword extraction falls back to local rules and vectors to a
# local hash, so section 2 alone is enough to run the benchmark.

# ============================================================
# 1. Provider — switching this one line switches the whole stack
#    openai    = OpenAI-compatible protocol (/chat/completions + Authorization: Bearer)
#    anthropic = Anthropic Messages protocol (/v1/messages + x-api-key)
# ============================================================
AI_SQL_MODEL_PROVIDER=openai

# ============================================================
# 2. Credentials — only the provider selected above is used.
#    BASE_URL takes the official endpoint or your own relay.
# ============================================================

# ---- OpenAI-compatible channel (OpenAI, relays, vLLM and Ollama all speak this) ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Anthropic channel ----
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Heads-up: environment variables outrank .env. A terminal with Claude Code
# installed exports ANTHROPIC_BASE_URL, which silently overrides the line above
# and shows up as a 401 when you meant to reach a relay. Use the AI_SQL_ prefix
# instead — highest priority, and it cannot collide with another tool:
# AI_SQL_ANTHROPIC_API_KEY=sk-ant-your-key-here
# AI_SQL_ANTHROPIC_BASE_URL=https://your-relay.example.com

# ============================================================
# 3. Models — leave unset to take the provider default
#    openai    -> gpt-5.6-luna      ($0.20 / $1.20 per 1M tokens, Sept 2026)
#    anthropic -> claude-sonnet-5
#    AI_SQL_CHAT_MODEL  = planning / routing / keyword extraction
#    AI_SQL_CODER_MODEL = SQL generation, worth a stronger model on wide schemas
# ============================================================
# AI_SQL_CHAT_MODEL=gpt-5.6-luna
# AI_SQL_CODER_MODEL=gpt-5.6-terra
# AI_SQL_CHAT_MODEL=claude-sonnet-5
# AI_SQL_CODER_MODEL=claude-opus-5

# The Anthropic Messages protocol requires an explicit max_tokens. This is the default.
# AI_SQL_MAX_OUTPUT_TOKENS=4096

# OpenAI reasoning models (gpt-5 and later, o-series) are sent without temperature,
# with max_completion_tokens (which also covers the reasoning) and reasoning_effort.
# Low effort by default: one question makes five or six model calls, and each
# extra second of thinking adds up against the caller's timeout. Empty = model default.
# A relay that rejects one of these parameters gets the request again without it.
# AI_SQL_REASONING_EFFORT=low
# AI_SQL_MAX_COMPLETION_TOKENS=8192

# Sections 1-3 can also be changed in the console, without a restart:
# Settings -> Advanced settings -> Model connection (admin key required; with
# auth disabled, only from the machine the service runs on). A connection saved
# there outranks this file until "Restore server configuration". The saved copy
# holds the key in plain text (mode 0600). Turn it off for several replicas.
# AI_SQL_MODEL_SETTINGS_ENABLED=true
# AI_SQL_MODEL_SETTINGS_PATH=runtime_data/model_settings.json

# Schema retrieval vectors. local = hash vectors, no service call, no semantics
# ("how much" does not find an amount column; keywords carry the recall).
# remote = an OpenAI-compatible /embeddings endpoint: every table and column
# description is embedded at startup and on schema reload, and each question's
# keywords cost one request. If the endpoint fails at startup, retrieval falls
# back to local vectors and /admin/model says why. The console's
# Settings -> Advanced settings -> Embedding does the same and rebuilds the
# index before switching. 1024 dimensions suit OpenAI text-embedding-3 and
# DashScope text-embedding-v4 alike.
# AI_SQL_EMBEDDING_BACKEND=remote
# AI_SQL_EMBEDDING_URL=https://api.openai.com/v1/embeddings
# AI_SQL_EMBEDDING_API_KEY=sk-your-key-here   # empty = OPENAI_API_KEY
# AI_SQL_EMBEDDING_MODEL=text-embedding-3-small
# AI_SQL_EMBEDDING_DIMENSIONS=1024
# AI_SQL_EMBEDDING_BATCH_SIZE=10              # texts per request; DashScope caps it at 10, OpenAI allows 2048
# AI_SQL_EMBEDDING_TIMEOUT_SECONDS=15

# ============================================================
# 4. Business semantics — what the model knows about your data
#    Leave unset to use the four built-in demo databases.
#    Point it at your own metadata when connecting real databases:
#      python -m ai_sql_agent.semantic export semantic/     # template
#      python -m ai_sql_agent.semantic validate semantic/   # check against live schema
#    Without it, retrieval falls back to literal column-name matching and
#    everyday phrasing stops resolving — it looks like a weak model, but the
#    model was simply never told what the business means.
# ============================================================
# AI_SQL_SEMANTIC_DIR=semantic/
# Simplified cabinet-shop example (9 tables / 60 columns):
#   python tools/simple_erp/build.py
# AI_SQL_SEMANTIC_DIR=tools/simple_erp/semantic

# ============================================================
# 5. Feedback loop — how the system gets better with use
#    Users mark answers right or wrong in the console. Wrong ones feed the
#    eval set (python -m ai_sql_agent.feedback export-dataset), confirmed ones become
#    reference queries injected into later prompts for similar questions.
# ============================================================
# AI_SQL_FEEDBACK_ENABLED=true
# AI_SQL_CERTIFIED_SQL_ENABLED=true
# AI_SQL_CERTIFIED_SQL_TOP_K=2

# ============================================================
# 6. Service auth — unrelated to the model keys above; this one guards
#    the API this project itself exposes.
#    Local dev defaults to disabled. Production sets api_key and mounts
#    deploy/api_keys.json (see docs/deployment.md).
# ============================================================
# AI_SQL_AUTH_MODE=api_key
# AI_SQL_API_KEYS_FILE=deploy/api_keys.json

# ============================================================
# 6b. Data browser — the console's "Data" page (GET /catalog and the
#     read-only preview). It reuses the caller identity and table/column
#     policy of /query and the same read-only executor; these only tune limits.
# ============================================================
# AI_SQL_CATALOG_ENABLED=true
# AI_SQL_CATALOG_PREVIEW_MAX_PAGE_SIZE=100
# Deepest row a preview can page to; narrow with a filter to see further.
# AI_SQL_CATALOG_PREVIEW_MAX_OFFSET=10000
# AI_SQL_CATALOG_PREVIEW_TIMEOUT_SECONDS=5
# Browse requests per caller per minute, counted separately from questions.
# A key whose own rate_limit_per_minute is lower gets the lower value.
# AI_SQL_CATALOG_RATE_LIMIT_PER_MINUTE=120
# Table profiles behind the Data page's charts (record counts, value breakdowns,
# records per month). Aggregates only, same policy as the preview, but each one is
# a full scan bounded by the preview timeout. On very large tables turn just this
# off: the catalog and the preview keep working, the page shows no statistics.
# AI_SQL_CATALOG_PROFILE_ENABLED=true

# ============================================================
# 7. Local port — where the API listens on this machine (default 8000)
#    Read by scripts/run_api.sh, `make run` and the docker compose files.
#    run_api.sh first stops an older copy of this API; if something else
#    holds the port it names that process and exits instead of killing it.
# ============================================================
# AI_SQL_PORT=8000

# ============================================================
# 8. Local stores — where this instance keeps its own state.
#    Relative paths resolve against the directory the API is started in.
#    Two instances on one machine (for example the real service and a
#    practice copy) must not share these files: with a shared memory file,
#    questions asked on one instance show up as "earlier results" on the other.
#    Unset = the defaults below, which is where existing data already lives.
# ============================================================
# AI_SQL_MEMORY_DB_PATH=runtime_data/memory.db
# AI_SQL_AUDIT_DB_PATH=runtime_data/audit.db
#
#  Run records and event logs (GET /runs/{id}/events). With a PostgreSQL DSN
#  they go to the same instance as the audit log. Losing this file loses
#  history only; queries are unaffected. Runs are deleted this many days
#  after they finish.
# AI_SQL_RUNS_ENABLED=true
# AI_SQL_RUNS_DB_PATH=runtime_data/runs.db
# AI_SQL_RUNS_RETENTION_DAYS=7
#
#  Cancel a run when the caller disconnects (/query, A2A send and stream).
#  On by default: a2a-contract v1.13 §5.4 says the server stops at the next
#  checkpoint once the caller has gone. Set it to false to get the v1.12
#  behaviour back (the query runs to the end). The console's stop button
#  cancels through POST /runs/{id}/cancel either way.
# AI_SQL_CANCEL_ON_DISCONNECT=true
#
#  Hard cap on one run's duration, enforced at the next checkpoint. 0 = none.
#  If set, keep it above the caller's own limit (90 s for the helpdesk).
# AI_SQL_RUN_DEADLINE_SECONDS=0

# ============================================================
# 9. Query limits — applied to every query the API runs, generated SQL and
#    Data-page previews alike. Rows beyond the cap are dropped and the step is
#    marked truncated; a query over the time limit is aborted in the database.
#    Both must be positive: 0 is rejected at startup, it does not mean "unlimited".
#    Raising the row cap also grows /query responses, A2A results and what
#    conversation memory stores per answer (see docs/deployment.md).
#    Unset = the defaults below, which are the limits that were already in force.
# ============================================================
# AI_SQL_MAX_ROWS=1000
# AI_SQL_MAX_EXECUTION_SECONDS=10
#
#  Result size, not just row count. Defaults: 8 MiB each.
#    AI_SQL_MAX_RESULT_BYTES  all values of one result together; rows past it are
#                             dropped and the step is marked truncated
#    AI_SQL_MAX_VALUE_BYTES   SQLite only: longest single string / BLOB / row
#                             (SQLITE_LIMIT_LENGTH); a longer value aborts the
#                             statement. Stored rows longer than this cannot be read.
# AI_SQL_MAX_RESULT_BYTES=8388608
# AI_SQL_MAX_VALUE_BYTES=8388608
