          "page_size": {
            "default": 25,
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Page Size",
            "type": "integer"
          },
          "search": {
            "default": "",
            "maxLength": 100,
            "title": "Search",
            "type": "string"
          },
          "sort": {
            "anyOf": [
