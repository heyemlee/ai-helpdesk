{
  "components": {
    "schemas": {
      "FeedbackRequest": {
        "description": "用户对一次回答的判定。\n\n只收 trace_id 与判定本身：问题原文与实际执行的 SQL 从审计记录回填，\n不接受客户端传。否则「这条 SQL 是对的」就成了客户端说了算，\n而认证 SQL 会被注入后续查询的生成 Prompt。",
        "properties": {
          "comment": {
            "default": "",
            "maxLength": 2000,
            "title": "Comment",
            "type": "string"
          },
          "trace_id": {
            "minLength": 1,
            "title": "Trace Id",
            "type": "string"
          },
          "verdict": {
            "enum": [
              "correct",
              "wrong",
              "unsure"
            ],
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "verdict"
        ],
        "title": "FeedbackRequest",
        "type": "object"
      },
      "FeedbackResponse": {
        "properties": {
          "certified": {
            "default": false,
            "title": "Certified",
            "type": "boolean"
          },
          "message": {
            "default": "",
            "title": "Message",
            "type": "string"
          },
          "recorded": {
            "title": "Recorded",
            "type": "boolean"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          },
          "verdict": {
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "recorded",
          "trace_id",
          "verdict"
        ],
        "title": "FeedbackResponse",
        "type": "object"
      },
