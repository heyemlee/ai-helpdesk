  "info": {
    "description": "自然语言数据查询 Agent：动态路由 + 三层 Schema 检索 + CoT 规划 + SQL 生成 + MCP 路由执行 + 长短期记忆。",
    "title": "AI SQL Agent API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/a2a": {
      "post": {
        "operationId": "a2a_endpoint_a2a_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "A2A Endpoint"
      }
    },
    "/a2a/databases": {
      "get": {
        "description": "生效中的业务库清单（契约 §4.5）。\n\nAgent Card 里已经带了同一份，这个端点是给「只想拉清单、不想解析整张 Card」\n的调用方用的。两处同源，不会各说各话。",
        "operationId": "database_manifest_a2a_databases_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Database Manifest A2A Databases Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Database Manifest"
      }
    },
    "/admin/circuit/reset": {
      "post": {
        "description": "手动复位模型熔断器，并清掉已记下的模型访问故障（凭证被拒 / 额度耗尽 / 模型无权限）。\n\n模型侧确认恢复后不想等冷却、或者凭证 / 额度在服务端修好了又不想重启时用。\n（换一把 Key 不用来这里：在页面上保存模型连接时会自动清一遍，见 `/admin/model`。）\n这里**不验证**凭证是不是真的好了：清掉之后，下一个真实请求会再去试一次，\n还是被拒就重新记下。需要管理员身份；没有、也不打算有匿名的复位入口。",
        "operationId": "reset_circuits_admin_circuit_reset_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Reset Circuits Admin Circuit Reset Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Reset Circuits"
      }
    },
    "/admin/model": {
      "delete": {
        "description": "丢掉页面保存的模型连接，回到环境变量和 `.env` 给出的那一份，立刻生效。",
        "operationId": "clear_model_admin_model_delete",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Clear Model Admin Model Delete",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Clear Model"
      },
      "get": {
        "description": "现在用的模型连接（主链路和 Embedding），以及这个请求能不能改它。",
        "operationId": "model_status_admin_model_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Model Status Admin Model Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Model Status"
      },
      "put": {
        "description": "保存模型连接并立刻生效。之后它压过环境变量和 `.env`，直到有人调 DELETE。\n\n这里不验证连接能不能用——先调 `/admin/model/test`。保存一份不通的连接不会让服务挂掉：\n问答会照「模型不可用」降级，直到换成一份能用的。",
        "operationId": "save_model_admin_model_put",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Save Model Admin Model Put",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Save Model"
      }
    },
    "/admin/model/embedding": {
      "delete": {
        "description": "丢掉页面保存的 Embedding，回到服务端配置的那一种，并按它重建检索索引。\n\n服务端配的是远端、而它调不通时，和启动时一样退回本地哈希向量（状态里的 `fallback`）。",
        "operationId": "clear_embedding_model_admin_model_embedding_delete",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Clear Embedding Model Admin Model Embedding Delete",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Clear Embedding Model"
      },
      "put": {
        "description": "换 Embedding：测试 → 用新模型把 Schema 检索索引整个建好 → 保存 → 换上。\n\n要几秒到几十秒（Schema 里每张表、每个字段都要算一次向量）。测试没通过、索引建不出来、\n文件写不了，都在换上之前停下：正在用的索引和保存的文件都不动。",
        "operationId": "save_embedding_model_admin_model_embedding_put",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Save Embedding Model Admin Model Embedding Put",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Save Embedding Model"
